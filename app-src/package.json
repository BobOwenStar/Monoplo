{
  "name": "custom-discord-rpc-app",
  "version": "1.0.0",
  "private": true,
  "description": "Custom Discord Rich Presence app with a settings UI, for Spotify/Apple Music + Hitman 3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.9",
    "windows-media-sessions": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.customdiscordrpc",
    "productName": "Custom Discord RPC",
    "publish": [
      {
        "provider": "github",
        "owner": "BobOwenStar",
        "repo": "Monoplo",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Custom Discord RPC",
      "uninstallDisplayName": "Custom Discord RPC"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,changelog.md}"
    ]
  }
}
